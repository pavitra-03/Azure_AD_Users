import os
import requests
import secrets
import string
from datetime import datetime

# ============================================================
# CONFIGURATION FROM ENVIRONMENT VARIABLES
# ============================================================

TENANT_ID = os.environ.get("AZURE_TENANT_ID")
CLIENT_ID = os.environ.get("AZURE_CLIENT_ID")
CLIENT_SECRET = os.environ.get("AZURE_CLIENT_SECRET")
DOMAIN = os.environ.get("AZURE_DOMAIN", "Sacumentech432.onmicrosoft.com")

if not all([TENANT_ID, CLIENT_ID, CLIENT_SECRET]):
    print("ERROR: Missing required Azure credentials in environment variables.")
    print("Ensure AZURE_TENANT_ID, AZURE_CLIENT_ID, and AZURE_CLIENT_SECRET are set.")
    exit(1)

GRAPH_URL = "https://graph.microsoft.com/v1.0"

USERS_PER_DAY = 5
GROUPS_PER_DAY = 2

# ============================================================
# AUTHENTICATION
# ============================================================

token_url = (
    f"https://login.microsoftonline.com/"
    f"{TENANT_ID}/oauth2/v2.0/token"
)

token_data = {
    "client_id": CLIENT_ID,
    "client_secret": CLIENT_SECRET,
    "scope": "https://graph.microsoft.com/.default",
    "grant_type": "client_credentials"
}

response = requests.post(
    token_url,
    data=token_data,
    timeout=30
)

if response.status_code != 200:
    print("ERROR: Authentication failed")
    print(response.text)
    exit(1)

access_token = response.json()["access_token"]

headers = {
    "Authorization": f"Bearer {access_token}",
    "Content-Type": "application/json"
}

print("SUCCESS: Authentication completed")

# ============================================================
# DATE
# ============================================================

today = datetime.now().strftime("%Y%m%d")

print(f"Generating data for: {today}")

# ============================================================
# PASSWORD
# ============================================================

def generate_password():
    chars = string.ascii_letters + string.digits + "!@#$%^&*"
    return "".join(secrets.choice(chars) for _ in range(18))

# ============================================================
# CREATE GROUPS
# ============================================================

created_groups = []

print("\nCreating groups...")

for i in range(1, GROUPS_PER_DAY + 1):

    group_name = (
        f"Securonix-Security-Group-{today}-{i:02d}"
    )

    group_data = {
        "displayName": group_name,
        "mailEnabled": False,
        "mailNickname":
            f"SecuronixSecurity{today}{i:02d}",
        "securityEnabled": True
    }

    response = requests.post(
        f"{GRAPH_URL}/groups",
        headers=headers,
        json=group_data,
        timeout=30
    )

    if response.status_code == 201:

        group = response.json()

        created_groups.append({
            "id": group["id"],
            "displayName": group["displayName"]
        })

        print(f"SUCCESS: Group created - {group_name}")

    else:
        print(
            f"ERROR: Group creation failed - "
            f"{group_name}"
        )
        print(response.text)

# ============================================================
# CREATE USERS
# ============================================================

created_users = []

print("\nCreating users...")

for i in range(1, USERS_PER_DAY + 1):

    username = (
        f"securonix.test.{today}.{i:02d}"
    )

    display_name = (
        f"Securonix Test User "
        f"{today}-{i:02d}"
    )

    upn = f"{username}@{DOMAIN}"

    user_data = {
        "accountEnabled": True,
        "displayName": display_name,
        "mailNickname":
            username.replace(".", ""),
        "userPrincipalName": upn,
        "passwordProfile": {
            "forceChangePasswordNextSignIn": False,
            "password": generate_password()
        }
    }

    response = requests.post(
        f"{GRAPH_URL}/users",
        headers=headers,
        json=user_data,
        timeout=30
    )

    if response.status_code == 201:

        user = response.json()

        created_users.append({
            "id": user["id"],
            "displayName": user["displayName"],
            "userPrincipalName":
                user["userPrincipalName"]
        })

        print(
            f"SUCCESS: User created - "
            f"{display_name}"
        )

    else:
        print(
            f"ERROR: User creation failed - "
            f"{display_name}"
        )
        print(response.text)

# ============================================================
# ADD USERS TO GROUPS
# ============================================================

print("\nAdding users to groups...")

for index, user in enumerate(created_users):

    if not created_groups:
        break

    group = created_groups[
        index % len(created_groups)
    ]

    member_url = (
        f"{GRAPH_URL}/groups/"
        f"{group['id']}/members/$ref"
    )

    member_data = {
        "@odata.id":
            f"{GRAPH_URL}/directoryObjects/"
            f"{user['id']}"
    }

    response = requests.post(
        member_url,
        headers=headers,
        json=member_data,
        timeout=30
    )

    if response.status_code == 204:
        print(
            f"SUCCESS: {user['displayName']} "
            f"added to {group['displayName']}"
        )
    else:
        print("ERROR: Failed to add user to group")
        print(response.text)

# ============================================================
# VALIDATION
# ============================================================

print("\nValidating Users API...")

response = requests.get(
    f"{GRAPH_URL}/users?$top=100",
    headers=headers,
    timeout=30
)

if response.status_code == 200:
    users = response.json().get("value", [])
    print(
        f"SUCCESS: Users API returned "
        f"{len(users)} records"
    )
else:
    print("ERROR: Users API validation failed")
    print(response.text)

print("\nValidating Groups API...")

response = requests.get(
    f"{GRAPH_URL}/groups?$top=100",
    headers=headers,
    timeout=30
)

if response.status_code == 200:
    groups = response.json().get("value", [])
    print(
        f"SUCCESS: Groups API returned "
        f"{len(groups)} records"
    )
else:
    print("ERROR: Groups API validation failed")
    print(response.text)

print("\n===================================")
print(" AZURE AD DATA GENERATION COMPLETE")
print("===================================")
print(f"Users created : {len(created_users)}")
print(f"Groups created: {len(created_groups)}")
